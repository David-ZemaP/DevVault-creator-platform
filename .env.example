# WalletConnect / RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# RPC Providers
# 1. Avalanche (Content Proofs)
NEXT_PUBLIC_AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
NEXT_PUBLIC_AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# 2. HashKey Chain / HSK (Membership Gating - from unlock-hashkey service)
NEXT_PUBLIC_HSK_RPC_URL=https://testnet.hsk.xyz
NEXT_PUBLIC_HSK_TESTNET_RPC_URL=https://testnet.hsk.xyz

# Deployed Contract Addresses
# Content Proof Registry on Avalanche Fuji
NEXT_PUBLIC_CONTENT_PROOF_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Unlock PublicLock on HashKey Chain (received from unlock-hashkey repo)
NEXT_PUBLIC_UNLOCK_HSK_LOCK_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_UNLOCK_LOCK_ADDRESS=0x0000000000000000000000000000000000000000

# Backend / API
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Deployment Private Key (Hardhat)
PRIVATE_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Marketplace authentication (must match the browser origin exactly)
APP_ORIGIN=http://localhost:3000
# Apply schema.sql then marketplace, acquisition_model and auth_sessions migrations.
# See docs/SECURITY_ARCHITECTURE.md for the exact order and development setup.
# Marketplace requires SUPABASE_SERVICE_ROLE_KEY; no anonymous or memory fallback.
# Private bucket: source-artifacts (migration creates it). Download TTL: 600 seconds.
