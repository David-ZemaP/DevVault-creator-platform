# WalletConnect / RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# RPC Providers
NEXT_PUBLIC_AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
NEXT_PUBLIC_AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Deployed Contract Addresses
NEXT_PUBLIC_CONTENT_PROOF_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_UNLOCK_LOCK_ADDRESS=0x0000000000000000000000000000000000000000

# Backend / API
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Hardhat deployment (environment variables must be set in the invoking shell).
# Optional Fuji RPC override; blank uses the public Fuji RPC fallback.
AVALANCHE_FUJI_RPC_URL=
# PRIVATE_KEY must belong to a disposable development wallet only.
# Never commit a populated .env. No mainnet funds should be used.
PRIVATE_KEY=
